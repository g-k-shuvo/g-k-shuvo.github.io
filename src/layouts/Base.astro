---
import '../styles/global.css';
// Vite resolves this to the emitted, hashed URL so the preload can never drift
// from the file the stylesheet actually requests.
import geistSans from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Absolute, as crawlers require — a relative og:image is silently ignored.
const ogImage = new URL('/og.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preload" as="font" type="font/woff2" href={geistSans} crossorigin />
		<meta name="author" content="Golam Kibria" />
		<!-- Google Search Console, URL-prefix property. A Domain property is not
		     possible here: github.io is GitHub's domain, so its DNS is not ours
		     to add a TXT record to. -->
		<meta
			name="google-site-verification"
			content="Aj2tBOmspma5IOK-pL1uacs-EpuPV8JPNl3h_3_ocic"
		/>
		<meta name="theme-color" content="#0b0b0e" />
		<meta
			name="keywords"
			content="Golam Kibria, software engineer, full stack developer, Django, React, Vue, Node.js, AWS, GCP, RAG, machine learning, Bangladesh, remote"
		/>

		<meta property="og:type" content="profile" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Golam Kibria" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Golam Kibria — Software Engineer" />
		<meta property="profile:first_name" content="Golam" />
		<meta property="profile:last_name" content="Kibria" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Golam Kibria — Software Engineer" />

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify([
				{
					'@context': 'https://schema.org',
					'@type': 'Person',
					'@id': 'https://g-k-shuvo.github.io/#person',
					name: 'Golam Kibria',
					givenName: 'Golam',
					familyName: 'Kibria',
					jobTitle: 'Software Engineer',
					description,
					url: 'https://g-k-shuvo.github.io/',
					image: ogImage,
					email: 'mailto:gkshuvo24@gmail.com',
					worksFor: { '@type': 'Organization', name: 'Techjays' },
					alumniOf: {
						'@type': 'CollegeOrUniversity',
						name: 'Metropolitan University'
					},
					address: { '@type': 'PostalAddress', addressCountry: 'BD' },
					knowsAbout: [
						'Full-stack web development',
						'Django',
						'React',
						'Vue',
						'Node.js',
						'Python',
						'PostgreSQL',
						'Amazon Web Services',
						'Google Cloud Platform',
						'Docker',
						'Retrieval-augmented generation',
						'Machine learning integration'
					],
					sameAs: ['https://github.com/g-k-shuvo', 'https://www.linkedin.com/in/g-k-shuvo/']
				},
				{
					'@context': 'https://schema.org',
					'@type': 'WebSite',
					'@id': 'https://g-k-shuvo.github.io/#website',
					url: 'https://g-k-shuvo.github.io/',
					name: 'Golam Kibria',
					description,
					inLanguage: 'en',
					author: { '@id': 'https://g-k-shuvo.github.io/#person' }
				}
			])}
		/>

		<script is:inline>
			// Analytics is 160KB of JavaScript. Loaded normally it evaluates during
			// first paint and cost ~600ms of the 800ms total blocking time on a
			// mid-tier phone. It now waits for the visitor to act or leave (see
			// below). Nothing is lost: gtag() queues into dataLayer immediately and
			// the library drains the queue when it lands.
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-7XXPE0DV47');

			(function () {
				var loaded = false;
				function loadGA() {
					if (loaded) return;
					loaded = true;
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=G-7XXPE0DV47';
					document.head.appendChild(s);
				}
				// Two triggers, no timer. Either the visitor does something — which
				// is the moment the session becomes worth measuring — or the
				// session ends, which is the last moment it can be reported. A
				// page open and untouched is a session that has not happened yet,
				// so there is nothing to send and no reason to spend the visitor's
				// main thread on 160KB of analytics.
				var events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
				function onFirstInput() {
					events.forEach(function (e) {
						window.removeEventListener(e, onFirstInput, true);
					});
					loadGA();
				}
				events.forEach(function (e) {
					window.addEventListener(e, onFirstInput, { capture: true, passive: true, once: true });
				});
				function onEnd() {
					if (document.visibilityState === 'hidden') loadGA();
				}
				document.addEventListener('visibilitychange', onEnd);
				window.addEventListener('pagehide', loadGA);
			})();
		</script>
	</head>

	<body>
		<!--
		THESIS: The category standard executed at material grade, chosen by the user over a
		dealt hand of committed worlds. Refuses the expressive concept portfolio and the
		generic dev template alike; the work is the only colour on the page.
		OWN-WORLD: True near-black #0B0B0E under a measured grain — a few levels off the
		floor because a black shadow needs somewhere to fall. Three plane tiers (#0D0D11
		sunken, #16161A base, #1C1C22 raised), each with a specular top edge lit at rest
		and a real offset shadow. Geist at three sizes, greyscale throughout, one
		functional live-green dot. No accent, no gradient, no eyebrow.
		STORY: A hiring manager skimming to disqualify learns in seconds that one engineer
		shipped seven enterprise domains end to end, finds the proof, and mails him.
		FIRST VIEWPORT: Name at display scale left, role and a two-sentence factual claim
		beneath it, live availability, a white Email pill as the primary action; portrait
		right on a raised plane catching the light. The Techjays index begins at the fold.
		FORM: Category standard — the standing exit, user-chosen against the roll; craft bar
		Raycast/Arc/Family; signature motion is the raking light. Seed key 153ed001.
		FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
		-->
		<div class="grain" aria-hidden="true"></div>
		<slot />

		<script>
			import { rakingLight } from '../scripts/raking-light';
			rakingLight();
		</script>
	</body>
</html>
