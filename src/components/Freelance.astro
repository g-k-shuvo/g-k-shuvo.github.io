---
import freelance from '../data/freelance.json';
---

<section id="freelance">
	<div class="shell">
		<div class="section-head">
			<h2>{freelance.platform}</h2>
			<p class="meta">{freelance.type} &middot; {freelance.duration}</p>
		</div>

		<div class="role-head">
			<h3>{freelance.role}</h3>
		</div>

		<div class="block plane plane--sunken">
			<p class="summary">{freelance.summary}</p>
			<ul class="points">
				{freelance.points.map((point) => <li>{point}</li>)}
			</ul>
			<ul class="tags">
				{freelance.techStack.map((tech) => <li class="tag">{tech}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	/* Same role head as the Techjays section, so the two read as one history. */
	.role-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		margin-block-end: 1.75rem;
	}

	.role-head h3 {
		color: var(--ink);
		font-size: 1.375rem;
	}

	@media (max-width: 560px) {
		.role-head {
			flex-direction: column;
			gap: 0.25rem;
		}
	}

	/* One recessed well, the same treatment as an experience row: three years
	   of client work reads as one engagement type, not eighteen cards. */
	.block {
		padding: clamp(1.75rem, 3.5vw, 2.5rem);
	}

	.summary {
		color: var(--ink);
		font-size: 1.0625rem;
		line-height: 1.6;
		max-width: 62ch;
		margin-block-end: 1.25rem;
	}

	.points {
		list-style: none;
		display: grid;
		gap: 0.625rem;
		max-width: 62ch;
		margin-block-end: 1.5rem;
	}

	.points li {
		position: relative;
		padding-inline-start: 1.125rem;
		color: var(--ink-2);
		font-size: 0.9375rem;
		line-height: 1.7;
	}

	/* A hairline dash, not a bullet glyph: quieter, and it inherits the line token. */
	.points li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		top: 0.85em;
		width: 0.5rem;
		height: 1px;
		background: var(--line-strong);
	}
</style>
